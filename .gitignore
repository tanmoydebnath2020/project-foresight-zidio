# ==========================================
# Data Files (Ignore large/generated files)
# ==========================================
# Ignore raw data files
src/data/*.xlsx
src/data/*.xls
src/data/*.csv

# Ignore large generated transaction files
# Ignore large processed files and raw data
src/data/foresight_data/processed/clean_transactions.csv
src/data/online_retail_II.xlsx
.DS_Store

